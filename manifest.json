{
  "manifest_version": 2,
  "name": "icspresso",
  "version": "1.2.1",
  "description": "Intercepts calendar downloads and adds events to Google Calendar",
  "browser_specific_settings": {
    "gecko": {
      "id": "icspresso@schaefer",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  }
}
